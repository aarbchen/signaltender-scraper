{
  "openapi": "3.0.3",
  "info": {
    "title": "SOC 2, FedRAMP & NIST 800-171 Security Questionnaire Responder API",
    "version": "1.0.0",
    "description": "Stateless AI Security Questionnaire Responder, Cross-Framework Control Mapper (SOC 2 Type II, NIST SP 800-171 Rev 2/3, CMMC 2.0, FedRAMP NIST 800-53 Rev 5, ISO 27001, CAIQ/SIG/HECVAT), DoD SPRS Readiness Estimator, and Plan of Action & Milestones (POA&M) Generator."
  },
  "servers": [
    {
      "url": "https://b2b-contract-parser-api.onrender.com",
      "description": "SignalTender Production FastAPI Gateway"
    }
  ],
  "paths": {
    "/v1/audit/security-questionnaire": {
      "post": {
        "tags": [
          "Security Questionnaire & GRC Automation"
        ],
        "summary": "Auto-answer SOC 2, FedRAMP, NIST 800-171 & CAIQ/SIG security questionnaires with POA&M mapping",
        "operationId": "audit_security_questionnaire_v1_audit_security_questionnaire_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SecurityQuestionnaireRequest"
              },
              "example": {
                "questionnaire_text": "1. Does your platform enforce phishing-resistant Multi-Factor Authentication (MFA) for all privileged and non-privileged users accessing CUI? 2. How is customer data encrypted at rest and in transit, and are cryptographic modules FIPS 140-2/140-3 validated? 3. Describe your SIEM audit log retention window and incident reporting SLA for federal cyber incidents (DFARS 252.204-7012).",
                "security_posture_summary": "Hosted on AWS US-East/West (commercial) and migrating federal workloads to AWS GovCloud. SOC 2 Type II certified. Okta SSO with WebAuthn/FIDO2 MFA enforced for all employees. Data encrypted via AES-256 at rest (AWS KMS) and TLS 1.3 in transit; FIPS-validated endpoints enabled on GovCloud ALB, pending full FIPS mode on commercial worker nodes. Datadog SIEM retains hot logs for 90 days and cold S3 archives for 365 days.",
                "target_framework": "auto_detect"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Security Questionnaire Response & POA&M Package",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SecurityQuestionnaireResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SecurityFrameworkTarget": {
        "type": "string",
        "enum": [
          "auto_detect",
          "soc2_iso27001",
          "nist_800_171_cmmc",
          "fedramp_800_53",
          "caiq_sig_hecvat"
        ],
        "title": "SecurityFrameworkTarget"
      },
      "ControlComplianceStatus": {
        "type": "string",
        "enum": [
          "COMPLIANT",
          "INHERITED_FROM_CSP",
          "PARTIAL_COMPENSATING_CONTROL",
          "GAP_REQUIRES_POAM"
        ],
        "title": "ControlComplianceStatus"
      },
      "SecurityQuestionnaireRequest": {
        "type": "object",
        "required": [
          "questionnaire_text",
          "security_posture_summary"
        ],
        "properties": {
          "questionnaire_text": {
            "type": "string",
            "minLength": 20,
            "title": "Questionnaire Text",
            "description": "Raw security questionnaire items from an enterprise SIG/CAIQ/HECVAT spreadsheet, vendor security assessment, or Federal RFP / SSP checklist."
          },
          "security_posture_summary": {
            "type": "string",
            "minLength": 15,
            "title": "Security Posture Summary",
            "description": "Summary of the vendor's cloud infrastructure, certifications (SOC 2, ISO 27001, FedRAMP, CMMC), encryption, IAM/MFA, and logging controls."
          },
          "target_framework": {
            "$ref": "#/components/schemas/SecurityFrameworkTarget",
            "default": "auto_detect",
            "description": "Target compliance framework focus ('auto_detect', 'soc2_iso27001', 'nist_800_171_cmmc', 'fedramp_800_53', or 'caiq_sig_hecvat')."
          }
        },
        "title": "SecurityQuestionnaireRequest"
      },
      "FrameworkAndSPRSSummary": {
        "type": "object",
        "required": [
          "primary_framework_detected",
          "estimated_sprs_or_control_maturity",
          "fully_met_controls_count",
          "partially_met_or_inherited_count",
          "gap_or_poam_required_count"
        ],
        "properties": {
          "primary_framework_detected": {
            "type": "string",
            "title": "Primary Framework Detected"
          },
          "estimated_sprs_or_control_maturity": {
            "type": "string",
            "title": "Estimated SPRS Or Control Maturity"
          },
          "fully_met_controls_count": {
            "type": "integer",
            "minimum": 0,
            "title": "Fully Met Controls Count"
          },
          "partially_met_or_inherited_count": {
            "type": "integer",
            "minimum": 0,
            "title": "Partially Met Or Inherited Count"
          },
          "gap_or_poam_required_count": {
            "type": "integer",
            "minimum": 0,
            "title": "Gap Or POAM Required Count"
          }
        },
        "title": "FrameworkAndSPRSSummary"
      },
      "SecurityQuestionResponseItem": {
        "type": "object",
        "required": [
          "question_id",
          "original_question",
          "compliance_status",
          "mapped_control_citations",
          "audit_ready_response",
          "evidence_artifact_to_attach"
        ],
        "properties": {
          "question_id": {
            "type": "string",
            "title": "Question Id"
          },
          "original_question": {
            "type": "string",
            "title": "Original Question"
          },
          "compliance_status": {
            "$ref": "#/components/schemas/ControlComplianceStatus"
          },
          "mapped_control_citations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "Mapped Control Citations"
          },
          "audit_ready_response": {
            "type": "string",
            "title": "Audit Ready Response"
          },
          "evidence_artifact_to_attach": {
            "type": "string",
            "title": "Evidence Artifact To Attach"
          }
        },
        "title": "SecurityQuestionResponseItem"
      },
      "POAMRemediationItem": {
        "type": "object",
        "required": [
          "gap_id",
          "control_reference",
          "deficiency_description",
          "compensating_control_or_poam_milestone"
        ],
        "properties": {
          "gap_id": {
            "type": "string",
            "title": "Gap Id"
          },
          "control_reference": {
            "type": "string",
            "title": "Control Reference"
          },
          "deficiency_description": {
            "type": "string",
            "title": "Deficiency Description"
          },
          "compensating_control_or_poam_milestone": {
            "type": "string",
            "title": "Compensating Control Or POAM Milestone"
          }
        },
        "title": "POAMRemediationItem"
      },
      "SecurityQuestionnaireResponse": {
        "type": "object",
        "required": [
          "questionnaire_title",
          "overall_readiness_score",
          "executive_compliance_attestation",
          "sprs_and_framework_summary",
          "question_responses",
          "poam_and_remediation_items"
        ],
        "properties": {
          "questionnaire_title": {
            "type": "string",
            "title": "Questionnaire Title"
          },
          "overall_readiness_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "title": "Overall Readiness Score"
          },
          "executive_compliance_attestation": {
            "type": "string",
            "title": "Executive Compliance Attestation"
          },
          "sprs_and_framework_summary": {
            "$ref": "#/components/schemas/FrameworkAndSPRSSummary"
          },
          "question_responses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SecurityQuestionResponseItem"
            },
            "title": "Question Responses"
          },
          "poam_and_remediation_items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/POAMRemediationItem"
            },
            "title": "POAM And Remediation Items"
          }
        },
        "title": "SecurityQuestionnaireResponse"
      }
    }
  }
}

