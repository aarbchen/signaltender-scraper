        "method": "POST",
        "url": "={{ $env.SLACK_OR_TEAMS_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \"⚡ *New SignalTender Capture OpportunitySynced to CRM*\\n*Solicitation:* {{ $node['SignalTender Incoming Webhook'].json.title }}\\n*Agency:* {{ $node['SignalTender Incoming Webhook'].json.agency }} | *Due:* {{ $node['SignalTender Incoming Webhook'].json.closing_date }}\\n*Dossier:* {{ $node['SignalTender Incoming Webhook'].json.dossier_url }}\"\n}",
        "options": {}
      },
      "id": "b1f2e3d4-0005-4000-8000-000000000005",
      "name": "Notify Capture Team (Slack / Microsoft Teams)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1020, 420]
    }
  ],
